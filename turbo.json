{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "vercel-build": {
      "dependsOn": [
        "@acme/db#generate",
        "@acme/db#migrate:deploy",
        "^vercel-build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "format": {
      "outputs": [],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^topo", "^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^topo", "^build"],
      "outputs": [".cache/tsbuildinfo.json"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "migrate:deploy": {
      "cache": false,
      "env": ["DATABASE_URL", "DIRECT_URL"]
    },
    "test": {
      "dependsOn": ["@acme/db#generate"],
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "test:ci": {
      "dependsOn": ["@acme/db#generate"],
      // Datadog Test Visibility: the GH action configures dd-trace via DD_*
      // env vars and NODE_OPTIONS preloads. Strict env mode strips them from
      // the task, leaving dd-trace half-initialized inside Vitest, which then
      // silently collects zero test files. Pass them through explicitly.
      //
      // DOCKER_HOST / TESTCONTAINERS_* are the same class of problem for local
      // runs: the Vitest global setup boots Testcontainers, and on a non-default
      // Docker daemon (colima, Rancher, a remote host) those vars are the only
      // way it finds the socket. Stripped, the containers never start and the
      // run dies with the same misleading "No test files found".
      "passThroughEnv": [
        "DD_*",
        "NODE_OPTIONS",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ],
      // Coverage reports must survive cache replays so the Datadog coverage
      // upload step still finds them on cache-hit runs.
      "outputs": ["coverage/**"]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "SESSION_SECRET",
    "PORT",
    "POSTMAN_API_KEY",
    "DD_SERVICE",
    "REDIS_URL",
    "REDIS_PREFIX",
    "CACHE_HOSTNAME",
    "CACHE_PORT",
    "CACHE_USERNAME",
    "CACHE_PASSWORD",
    "CACHE_KEY_PREFIX",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ENVIRONMENT",
    "NEXT_PUBLIC_SHOW_OGP_BRANDING"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "SKIP_ENV_VALIDATION",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "npm_lifecycle_event"
  ]
}
