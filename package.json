{
  "name": "@acme/monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:deploy": "turbo -F @acme/db migrate:deploy",
    "_comment:db": "push/migrate/studio bypass turbo on purpose: Prisma prompts on these (data-loss confirmation, migration name, long-lived Studio server) and turbo refuses to run tasks marked `interactive` unless its TUI is active, so `turbo -F` died with ERR 'Cannot run interactive task without Terminal UI'. db:deploy stays on turbo — it never prompts.",
    "db:migrate": "pnpm -F @acme/db migrate:dev",
    "db:push": "pnpm -F @acme/db push",
    "db:studio": "pnpm -F @acme/db studio",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @acme/web...",
    "format": "turbo run format --continue -- --check",
    "format:fix": "turbo run format --continue -- --write",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint --continue -- --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "vercel-build": "turbo run vercel-build",
    "bootstrap": "node scripts/bootstrap-app.mjs",
    "bootstrap:vercel": "node scripts/bootstrap-vercel.mjs",
    "bootstrap:sentry": "node scripts/bootstrap-sentry.mjs",
    "bootstrap:blob": "node scripts/bootstrap-blob.mjs",
    "bootstrap:deploy": "node scripts/bootstrap-deploy.mjs",
    "bootstrap:all": "node scripts/bootstrap-all.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@turbo/gen": "^2.9.16",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "catalog:",
    "turbo": "^2.9.16",
    "typescript": "catalog:",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,mdx,css,yml,yaml}": [
      "pnpm exec oxfmt"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
